# PostgreSQL connection string. Render supplies this from the linked database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/realhoroscope

# Strong private password used only for /yonetim. Do not prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Public canonical origin. Do not add a trailing slash.
NEXT_PUBLIC_SITE_URL=https://realhoroscope.online
